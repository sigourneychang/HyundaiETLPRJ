# Settings shared by the src and tgt Hive 2 clusters.
# bde2020 images turn these into *-site.xml entries:
#   PREFIX_a_b_c -> a.b.c   (___ -> '-', __ -> '_')
# Cluster-specific values (fs.defaultFS, metastore URI/DB) are set in docker-compose.yml.
HIVE_SITE_CONF_javax_jdo_option_ConnectionDriverName=org.postgresql.Driver
HIVE_SITE_CONF_javax_jdo_option_ConnectionUserName=hive
HIVE_SITE_CONF_javax_jdo_option_ConnectionPassword=hive
HIVE_SITE_CONF_datanucleus_autoCreateSchema=false

# ACID (Hive 2 needs all of these; compaction runs in the metastore process)
HIVE_SITE_CONF_hive_support_concurrency=true
HIVE_SITE_CONF_hive_txn_manager=org.apache.hadoop.hive.ql.lockmgr.DbTxnManager
HIVE_SITE_CONF_hive_compactor_initiator_on=true
HIVE_SITE_CONF_hive_compactor_worker_threads=1
HIVE_SITE_CONF_hive_exec_dynamic_partition_mode=nonstrict

CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_hadoop_proxyuser_root_hosts=*
CORE_CONF_hadoop_proxyuser_root_groups=*

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_replication=1
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# Local-mode MapReduce runs inside HiveServer2; concurrent queries then share in-process state and
# a job can read another query's input ("Invalid input path"). Run each MR job in its own JVM
# (like YARN containers in production). Cheap on native arm64.
HIVE_SITE_CONF_hive_exec_submitviachild=true
